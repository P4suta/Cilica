<Project>
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <Product>Cilica</Product>
    <PackageProjectUrl>https://github.com/hez2010/Cilica</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hez2010/Cilica</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>hez2010;dubiousconst282</Authors>

    <PackageOutputPath>$(SolutionDir)artifacts</PackageOutputPath>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
</Project>
